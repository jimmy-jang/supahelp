{
  "name": "supahelp-desktop",
  "version": "1.0.2",
  "private": true,
  "description": "Supahelp Desktop: resolve support requests across your tools.",
  "keywords": [],
  "license": "Apache-2.0",
  "author": {
    "name": "UnifyIT Limited"
  },
  "type": "module",
  "main": ".vite/build/main.cjs",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "make:mac:distribution": "SUPAHELP_MAC_DISTRIBUTION=1 electron-forge make --platform=darwin --arch=arm64",
    "release": "electron-forge release",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.renderer.json",
    "test": "node --import ./tests/support/test-guard.mjs --experimental-test-module-mocks --test \"tests/**/*.test.mjs\"",
    "test:packaged": "electron tests/e2e/native-smoke.cjs",
    "test:tour:e2e": "electron tests/e2e/quick-tour-smoke.cjs",
    "test:mac:install": "node tests/e2e/mac-install-smoke.mjs",
    "test:linear:e2e": "vite build --config tests/e2e/vite.linear.config.mts && electron tests/e2e/linear-smoke.cjs",
    "test:linear:runtimes": "node tests/e2e/linear-runtimes.mjs",
    "test:connectors:e2e": "npm run test:linear:e2e",
    "test:connectors:runtimes": "npm run test:linear:runtimes",
    "test:billing:ui": "node tests/e2e/build-billing-ui.mjs && electron tests/e2e/billing-smoke.cjs",
    "test:accounts:e2e": "vite build --config tests/e2e/vite.account.config.mts && electron tests/e2e/account-smoke.cjs",
    "test:onboarding:e2e": "vite build --config tests/e2e/vite.account.config.mts && electron tests/e2e/onboarding-smoke.cjs",
    "test:accounts:protocol": "electron tests/e2e/account-protocol.cjs",
    "test:cases:e2e": "vite build --config tests/e2e/vite.case.config.mts && electron tests/e2e/case-smoke.cjs",
    "test:playbooks:e2e": "vite build --config tests/e2e/vite.case.config.mts && electron tests/e2e/playbook-smoke.cjs",
    "test:sync:e2e": "vite build --config tests/e2e/vite.sync.config.mts && electron tests/e2e/sync-smoke.cjs",
    "test:collaboration:e2e": "vite build --config tests/e2e/vite.sync.config.mts && electron tests/e2e/collaboration-smoke.cjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.318",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@supahelp/contracts": "file:../../packages/contracts",
    "@workos-inc/node": "^12.2.0",
    "electron-squirrel-startup": "^1.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-dmg": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@tailwindcss/vite": "^4.3.4",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "45.2.3",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.91.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.3",
    "vite": "^8.3.6"
  },
  "engines": {
    "node": ">=24"
  },
  "productName": "Supahelp",
  "homepage": "https://supahelp.app"
}
